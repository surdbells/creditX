# ─── Application ───
APP_NAME=CreditX
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Lagos

# ─── Database ───
DB_DRIVER=pdo_pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=creditx
DB_USER=creditx_user
DB_PASSWORD=secret
DB_CHARSET=utf8

# ─── JWT ───
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=creditx-api
JWT_ALGORITHM=HS256

# ─── Redis ───
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=creditx:

# ─── Mail (ZeptoMail) ───
MAIL_DRIVER=zeptomail
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=noreply@dostsuite.com
ZEPTOMAIL_FROM_NAME=CreditX

# ─── SMS (Termii) ───
TERMII_API_KEY=
TERMII_SENDER_ID=CreditX

# ─── Payments (Paystack) ───
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# HMAC-SHA512 secret for verifying inbound Paystack webhooks. Paystack signs
# with your SECRET KEY, so set this to the same value as PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=

# ─── Settlements / payouts (Flutterwave) ───
# Only needed if settlement.provider = flutterwave. Secret key from the
# Flutterwave dashboard, and the static webhook verification hash you set
# under Settings → Webhooks (sent back in the verif-hash header).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ─── Push Notifications (Firebase Cloud Messaging) ───
# Download the service account JSON from Firebase Console → Project Settings
# → Service accounts → Generate new private key. Place it outside the repo
# (e.g. under backend/storage/firebase/) and set the absolute path below.
# chmod 600 the file and chown it to the www-data / nginx user.
# If unset, push notifications are disabled (sends fail silently with a
# logged warning; email/SMS channels still work normally).
FCM_SERVICE_ACCOUNT_PATH=

# ─── File Storage ───
STORAGE_DRIVER=local
STORAGE_PATH=storage/uploads
STORAGE_MAX_SIZE=10485760

# ─── CORS ───
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# ─── Frontend ───
FRONTEND_URL=https://admin.dostsuite.com

# ─── Rate Limiting ───
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ─── Logging ───
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_PATH=var/log/app.log
