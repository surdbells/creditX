creditx-agent/package-lock.json

# ── Android native project ──
# The android/ project is committed for reproducible builds (manifest
# permissions, capacitor config, google-services.json). Only build outputs,
# machine-specific files, and signing secrets are excluded.
/android/build/
/android/app/build/
# Gradle writes app/release/output-metadata.json (+ the APK) on every
# assembleRelease. It is build output, not source — tracking it made every
# build dirty the tree and invited stale version metadata into commits.
/android/app/release/
/android/.gradle/
/android/gradle/wrapper/gradle-wrapper.properties.lock
/android/captures/
/android/.idea/
/android/local.properties
/android/keystore.properties
/android/**/*.keystore
/android/**/*.jks
